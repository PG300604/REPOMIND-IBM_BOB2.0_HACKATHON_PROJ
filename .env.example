# ── LLM (at least one required) ───────────────────────────────────────────
# Free Groq key: https://console.groq.com
GROQ_API_KEY=

# Free Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── GitHub App (required for webhook auto-analysis) ───────────────────────
# Numeric App ID shown on: github.com/settings/apps/your-app
GITHUB_APP_ID=

# Full PEM private key — paste with literal \n between lines
# Download from: github.com/settings/apps/your-app → "Generate a private key"
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Secret set in the GitHub App webhook settings
GITHUB_WEBHOOK_SECRET=

# ── GitHub OAuth App (required for "Connect GitHub" UI flow) ──────────────
# Create at: github.com/settings/developers → OAuth Apps → New
# Callback URL: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Session security ──────────────────────────────────────────────────────
# Any random string — used to sign session cookies
SECRET_KEY=change-me-to-a-random-secret

# ── Optional: fallback personal token (for local dev without OAuth) ───────
GITHUB_TOKEN=
